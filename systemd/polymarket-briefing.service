[Unit]
Description=Polymarket morning briefing
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/cantabile/Works/morning-bell
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/morning-bell
ExecStart=/usr/bin/flock -w 600 %h/.local/state/morning-bell/run.lock %h/Works/morning-bell/.venv/bin/polymarket-briefing run --config %h/Works/morning-bell/config.yaml
TimeoutStartSec=20min
